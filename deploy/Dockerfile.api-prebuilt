# Explicit prebuilt-JAR route; does not claim Maven compilation inside Docker.
ARG JRE_IMAGE=eclipse-temurin@sha256:d5626b69d56330f64f1ebe514af0c7a73e6eb253fcb318f28bf399f31d02b88a
FROM ${JRE_IMAGE}
WORKDIR /app
COPY backend/target/course-selection-v2-2.0.0.jar /app/application.jar
COPY deploy/start-api.sh /app/start-api.sh
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["sh","/app/start-api.sh"]
